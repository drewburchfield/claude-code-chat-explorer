# Dependencies
node_modules/

# Database files (local only - container uses volume)
*.db
*.db-wal
*.db-shm

# Environment files
.env
.env.local

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Build artifacts
dist/
build/

# Claude local files (except CLAUDE.md)
.claude/
!repo/.claude/
!repo/cli-tool/.claude/

# Temporary files
tmp/
temp/

# Playwright MCP artifacts
.playwright-mcp/

# Internal planning artifacts (superpowers skill)
/docs/superpowers/
.clawpatch/

# Local review/QA artifacts - generated scan output, never committed.
# These contain findings and transcript excerpts from the local machine.
security_report/
dogfood-output/
*-report.md
sec_review_*.md

# Braintrust consult artifacts (goal cards, peer sessions). Local working
# notes, and they quote machine-specific measurements.
.braintrust/

# Private / work-in-progress notes. This repo is public: keep local thinking,
# drafts, and anything with personal or client detail out of it.
#
# These are ANCHORED to the repo root on purpose. Unanchored (`notes/`) would
# also swallow nested dirs like docs/research/, which IS tracked and published.
/NOTES.md
/TODO.local.md
/scratch/
/scratchpad/
/notes/
/private/
/wip/
/drafts/
*.local.md
*.private.md
*.draft.md

# Local agent/tool state
.aider*
.cursor/
.windsurf/
.codex/
.opencode/
.agy/
.serena/
.vibe/

# Credentials and env - never commit real values (.mcp.json.example is the
# tracked template; the real .mcp.json can hold tokens)
.mcp.json
*.pem
*.key
*.p12
secrets/
.secrets*
.envrc

# Local captures
*.har
screenshots/
videos/
*.webm
