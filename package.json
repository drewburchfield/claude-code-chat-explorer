{
  "name": "claude-code-chat-explorer",
  "version": "0.9.0",
  "description": "Browse, search, and explore your Claude Code conversation history with a fast SQLite-powered web interface",
  "license": "MIT",
  "private": true,
  "main": "src/chats-mobile.js",
  "bin": {
    "claude-chats-mcp": "src/mcp/server.js"
  },
  "scripts": {
    "start": "node -e \"require('./src/chats-mobile.js').startChatsMobile()\"",
    "mcp": "node src/mcp/server.js",
    "quality:gate": "bash scripts/quality-gate-local.sh",
    "monitor:runtime": "bash scripts/monitor-runtime.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "keywords": [
    "claude",
    "claude-code",
    "analytics",
    "dashboard",
    "sqlite",
    "monitoring",
    "conversations"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "12.6.2",
    "chalk": "^4.1.2",
    "chokidar": "^3.5.3",
    "express": "^4.18.2",
    "fs-extra": "^11.1.1",
    "open": "^8.4.2",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "supertest": "^7.0.0",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "8.5.19"
  },
  "engines": {
    "node": ">=20 <26"
  }
}
